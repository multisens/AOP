# Defaults to run the AoP. In a container, the image does not carry this
# file: the TV30 docker-compose.yml (service `aop`) sets the variables below,
# except REDIS_PORT, which keeps the default of the code (6379).
#
# Required (the server fails at startup without them): MQTT_HOST,
# REDIS_HOST, USER_DATA_PATH.

# Port of the HTTP server. Default 8080.
PORT=8080

# Each broadcaster application opens on its own origin, on the AoP port:
# http://<app>.<APPS_DOMAIN>:<AOP_PUBLIC_PORT>/graphicsAppProxy/... (on the
# host of the application the prefix is optional). <app> is a DNS label
# derived from the appId of the BALD (urn:tv30:app:users-test becomes
# urn-tv30-app-users-test); see src/app-hosts.js.
# Default apps.localhost: *.localhost resolves to the machine of whoever
# opens the page. With the AoP screen opened from another machine, the
# applications do not load; in that case use a domain resolvable on the
# network, with *.<domain> pointing to the AoP machine (wildcard DNS).
APPS_DOMAIN=apps.localhost

# Port by which the browser reaches the AoP (in the compose, the port
# published on the host). Default PORT (or 8080). It goes into the origin of
# each application.
#AOP_PUBLIC_PORT=8080

# [REQUIRED] Host name of the MQTT broker. In a container, the service name
# ('mosquitto'); outside a container, localhost (broker on the host).
MQTT_HOST=localhost

# The TV page connects MQTT to ws://<page host>/mqtt, on the AoP port, and
# the AoP passes it on to ws://MQTT_HOST:MQTT_WS_PORT (src/mqtt-ws.js).
# MQTT_WS_PORT is the port where the AoP reaches the Mosquitto WebSocket, not
# a port the browser uses. Default 9001. In a container the compose sets 9001
# (the INTERNAL port of mosquitto). With the AoP on the host and mosquitto in
# a container, use the published port, which Docker chooses: docker compose
# port mosquitto 9001. For a fixed published port: MQTT_WS_PUBLISH=9003:9001
# in the TV30 root .env and MQTT_WS_PORT=9003 here. An invalid value
# (outside 1 to 65535) stops the startup.
MQTT_WS_PORT=9001

# [REQUIRED] Directory with userData.json and thumbs/. In a container,
# /user-files (volume mounted from ./user-files in the TV30 root). The
# profile manager writes the avatar of each created profile to
# thumbs/<profile id>.svg (the avatar field is the file name) and reads it
# for the screens.
USER_DATA_PATH=/user-files

# [REQUIRED] Redis host: the platform reads profiles and writes the list of
# origins of associated applications directly to storage. In a container,
# the service name ('redis'); outside a container, localhost.
REDIS_HOST=localhost
REDIS_PORT=6379
