# Defaults pra rodar AoP. Em container, a imagem nao leva este arquivo: o
# docker-compose.yml do TV30 (service `aop`) define as variaveis abaixo, menos
# REDIS_PORT, que fica no padrao do codigo (6379).
#
# Required (server falha no boot se faltar): MQTT_HOST, REDIS_HOST, USER_DATA_PATH

# Porta do servidor HTTP. Default = 8080.
PORT=8080

# P1.3 (decisao do Luis em 10/10): cada aplicacao de emissora abre na sua
# propria origem, na mesma porta do AoP; desde a decisao do Luis em 11/10, a
# URL que a camada grafica abre mantem o prefixo do caminho antigo:
# http://<app>.<APPS_DOMAIN>:<AOP_PUBLIC_PORT>/graphicsAppProxy/... (no host
# da aplicacao o prefixo e opcional). O AoP roteia pelo cabecalho Host (proxy
# para o bcastEntryPackageUrl da aplicacao em execucao) e registra essa origem
# em origins:associated ao lancar a aplicacao; ver src/app-hosts.js. <app> e
# um rotulo DNS derivado do appId da BALD, fixo por aplicacao no bcast desde
# 11/10 (urn:tv30:app:users-test vira urn-tv30-app-users-test).
# Default = apps.localhost: *.localhost resolve para a maquina de QUEM abre a
# pagina. Com a tela do AoP aberta de outra maquina, as aplicacoes nao
# carregam; nesse caso use um dominio resolvivel na rede, com *.<dominio>
# apontando para a maquina do AoP (DNS curinga).
APPS_DOMAIN=apps.localhost

# Porta pela qual o NAVEGADOR alcanca o AoP (no compose, a porta publicada no
# host). Default = PORT (ou 8080). Entra na origem de cada aplicacao.
#AOP_PUBLIC_PORT=8080

# O caminho antigo /graphicsAppProxy/<caminho> no host do proprio AoP
# redireciona (302) para o mesmo caminho no host da aplicacao em execucao, e
# responde 404 sem aplicacao (decisao do Luis em 11/10); nao serve mais a
# aplicacao NA ORIGEM DO AoP.

# [REQUIRED] Hostname do broker MQTT. Em container = nome do service ('mosquitto').
# Fora de container = localhost (broker rodando no host).
MQTT_HOST=localhost

# MQTT por WebSocket da pagina da TV (C1, decisao do Luis em 11/10): a pagina
# conecta em ws://<host da pagina>/mqtt, na porta do proprio AoP, e o AoP
# repassa a ws://MQTT_HOST:MQTT_WS_PORT (src/mqtt-ws.js). MQTT_WS_PORT e a
# porta em que o AoP alcanca o WebSocket do Mosquitto, nao uma porta que o
# navegador use. Default = 9001. Em container o compose fixa 9001 (a porta
# INTERNA do mosquitto). Com o AoP no host e o mosquitto em container, use a
# porta publicada, que o Docker escolhe: docker compose port mosquitto 9001.
# Dica para quem roda o AoP fora do Docker no Windows (opcao, nao regra;
# decisao do Luis em 12/10): MQTT_WS_PUBLISH=9003:9001 no .env da raiz do TV30
# (porta publicada fixa) e MQTT_WS_PORT=9003 aqui.
# Valor invalido (fora de 1 a 65535) encerra o boot.
MQTT_WS_PORT=9001

# [REQUIRED] Diretorio com userData.json + thumbs/. Em container = /user-files
# (volume montado de ./user-files na raiz do TV30). Desde a decisao do Luis em
# 12/10 (G8), o gestor de perfis grava o avatar de cada perfil criado em
# thumbs/<id do perfil>.svg (o campo avatar e o nome do arquivo), apaga-o no
# despejo e o le para as telas; e o mesmo diretorio que o tv3ws entrega pela
# C.6.14.6 (USER_THUMBS dele).
USER_DATA_PATH=/user-files

# [REQUIRED] Host do Redis: a plataforma le perfis e escreve a lista de
# origens de aplicacoes associadas direto no armazenamento (P1).
# Em container = nome do service ('redis'); fora de container = localhost.
REDIS_HOST=localhost
REDIS_PORT=6379
