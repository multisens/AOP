<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Criar Perfil - AoP</title>
    <style>
        body {
            background-color: #121212;
            color: #ffffff;
            font-family: Arial, sans-serif;
            margin: 30px;
            padding: 0;
            font-size: 25px;
        }

        h1 {
            color: #ffffff;
            text-align: left;
            margin: 20px 0 20px 20px;
        }

        .container {
            padding: 20px;
            width: 85%;
            border-radius: 40px;
            display: inline-block;
            text-align: left;
            vertical-align: top;
            margin-bottom: 50px;
        }

        .content {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
        }

        input[type="text"], select {
            width: 100%;
            padding: 15px;
            margin: 10px 0;
            border: 2px solid #888888;
            border-radius: 8px;
            background-color: #2a2a2a;
            color: #ffffff;
            font-size: 18px;
        }

        .profile-options {
            display: flex;
            align-items: center;
            margin: 15px 0;
        }

        .profile-options input[type="checkbox"] {
            width: 20px;
            height: 20px;
            margin-right: 15px;
        }

        .language-options {
            margin: 20px 0;
        }

        .language-options label {
            display: block;
            margin-bottom: 10px;
            font-weight: bold;
        }

        .language-options select {
            width: 100%;
            margin: 5px 0;
        }

        .signing-config {
            background-color: #2a2a2a;
            padding: 20px;
            border-radius: 12px;
            margin: 20px 0;
            border: 2px solid #4CAF50;
        }

        .signing-config h3 {
            color: #4CAF50;
            margin-top: 0;
        }

        .signing-options {
            display: flex;
            gap: 30px;
            align-items: center;
        }

        .signing-options > div {
            flex: 1;
        }

        #closedSigningWidth {
            width: 100%;
            margin: 10px 0;
        }

        #width-value {
            color: #4CAF50;
            font-weight: bold;
            margin-left: 10px;
        }

        .content-rating-section {
            background-color: #2a2a2a;
            padding: 20px;
            border-radius: 12px;
            margin: 20px 0;
            border: 2px solid #ff9800;
        }

        .content-rating-section h3 {
            color: #ff9800;
            margin-top: 0;
        }

        .avatar-modal {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(0, 0, 0, 0.8);
            z-index: 1000;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .avatar-modal-content {
            background-color: #121212;
            border-radius: 12px;
            padding: 30px;
            width: 80%;
            max-width: 800px;
            max-height: 80%;
            overflow-y: auto;
            border: 2px solid #4CAF50;
        }

        .modal-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
            border-bottom: 2px solid #333;
            padding-bottom: 15px;
        }

        .modal-header h2 {
            margin: 0;
            color: #4CAF50;
        }

        .close-btn {
            background: none;
            border: none;
            color: #ffffff;
            font-size: 30px;
            cursor: pointer;
            padding: 0;
            width: 40px;
            height: 40px;
            border-radius: 50%;
            transition: background-color 0.3s ease;
        }

        .close-btn:hover {
            background-color: #333;
        }

        .avatar-categories {
            display: flex;
            gap: 10px;
            margin-bottom: 25px;
            justify-content: center;
        }

        .category-btn {
            padding: 12px 25px;
            border: 2px solid #888888;
            border-radius: 8px;
            background-color: #2a2a2a;
            color: #ffffff;
            font-size: 16px;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .category-btn:hover {
            border-color: #4CAF50;
        }

        .category-btn.active {
            background-color: #4CAF50;
            border-color: #4CAF50;
            color: #121212;
            font-weight: bold;
        }

        .avatar-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
            gap: 15px;
            margin: 25px 0;
            max-height: 400px;
            overflow-y: auto;
        }

        .avatar-option {
            border: 3px solid transparent;
            border-radius: 12px;
            cursor: pointer;
            transition: all 0.3s ease;
            padding: 10px;
            text-align: center;
            background-color: #2a2a2a;
        }

        .avatar-option:hover {
            border-color: #888888;
            transform: scale(1.05);
        }

        .avatar-option.selected {
            border-color: #4CAF50;
            background-color: #1a4a1a;
            transform: scale(1.1);
        }

        .avatar-option img {
            width: 80px;
            height: 80px;
            border-radius: 50%;
            object-fit: cover;
            margin-bottom: 8px;
        }

        .avatar-option .avatar-name {
            font-size: 12px;
            color: #cccccc;
        }

        .modal-actions {
            display: flex;
            gap: 20px;
            justify-content: center;
            margin-top: 25px;
            padding-top: 15px;
            border-top: 2px solid #333;
        }

        .modal-actions .btn {
            min-width: 120px;
        }

        .ratings {
            display: flex;
            gap: 10px;
            margin: 20px 0;
            justify-content: center;
        }

        .ratings img {
            width: 80px;
            height: auto;
            cursor: pointer;
            border: 3px solid transparent;
            border-radius: 8px;
            transition: border-color 0.3s ease;
        }

        .ratings img.selected {
            border-color: #4CAF50;
        }

        .accessibility-options {
            display: flex;
            flex-wrap: wrap;
            gap: 20px;
            margin: 30px 0;
        }

        .accessibility-item {
            display: flex;
            flex-direction: column;
            align-items: center;
            cursor: pointer;
            padding: 15px;
            border: 2px solid transparent;
            border-radius: 12px;
            transition: border-color 0.3s ease;
            min-width: 120px;
        }

        .accessibility-item.selected {
            border-color: #4CAF50;
            background-color: #1a4a1a;
        }

        .accessibility-item img {
            width: 60px;
            height: 60px;
            margin-bottom: 10px;
        }

        .avatar-section {
            text-align: center;
            padding: 20px;
            margin-left: 30px;
        }

        .avatar-button {
            background: none;
            border: 3px solid #888888;
            border-radius: 50%;
            padding: 10px;
            cursor: pointer;
            transition: border-color 0.3s ease;
        }

        .avatar-button:hover {
            border-color: #4CAF50;
        }

        .avatar-button img,
        .avatar-preview {
            width: 150px;
            height: 150px;
            border-radius: 50%;
            overflow: hidden;
            display: block;
        }

        .avatar-preview svg {
            width: 100%;
            height: 100%;
            display: block;
        }

        .avatar-option svg {
            width: 80px;
            height: 80px;
            border-radius: 50%;
            display: block;
            margin: 0 auto 8px;
        }

        .terms-actions {
            margin-top: 30px;
        }

        .terms {
            margin: 20px 0;
            display: flex;
            align-items: flex-start;
            gap: 15px;
        }

        .terms input[type="checkbox"] {
            width: 20px;
            height: 20px;
            margin-top: 5px;
        }

        .actions {
            display: flex;
            gap: 20px;
            justify-content: center;
            margin-top: 30px;
        }

        .btn {
            padding: 15px 30px;
            border: 2px solid #888888;
            border-radius: 8px;
            background-color: #2a2a2a;
            color: #ffffff;
            font-size: 18px;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .btn:hover {
            background-color: #4CAF50;
            border-color: #4CAF50;
        }

        .btn.advance {
            background-color: #4CAF50;
            border-color: #4CAF50;
        }

        .btn.advance:hover {
            background-color: #45a049;
        }

        a {
            color: #4CAF50;
            text-decoration: none;
        }

        a:hover {
            text-decoration: underline;
        }

        .kbd-focus {
            outline: 4px solid #4CAF50 !important;
            outline-offset: 4px;
            box-shadow: 0 0 12px rgba(76, 175, 80, 0.6);
        }
    </style>
    <script src="/jquery-3.7.1.min.js"></script>
    <script src="/navigation.js"></script>
</head>
<body>
    <h1>Criando seu Perfil Smart TV</h1>
    
    <div class="content">
        <div class="container">
            <form id="profile-form">
                <input type="text" id="name" name="name" placeholder="Nome do perfil (obrigatório, até 20 caracteres)" maxlength="20" required>

                <div class="language-options">
                    <label>Configurações de Idioma:</label>
                    <select id="audioLanguage" name="audioLanguage">
                        <option value="pt-BR">Áudio: Português</option>
                        <option value="en">Áudio: Inglês</option>
                    </select>
                    <select id="userInterfaceLanguage" name="userInterfaceLanguage">
                        <option value="pt-BR">Interface: Português</option>
                        <option value="en">Interface: Inglês</option>
                    </select>
                    <select id="closedCaptioningLanguage" name="closedCaptioningLanguage" style="display: none;">
                        <option value="pt-BR">Legendas: Português</option>
                        <option value="en">Legendas: Inglês</option>
                    </select>
                </div>

                <div class="profile-options">
                    <input type="checkbox" id="parental-control" name="parental-control">
                    <label for="parental-control">Ativar Controle Parental</label>
                </div>
                
                <div class="accessibility-options">
                    <div class="accessibility-item" onclick="toggleAccessibility('audio-description')">
                        <img id="audio-description" src="/media/audio-description.png" alt="Audiodescrição">
                        <label>Audiodescrição</label>
                    </div>
                    <div class="accessibility-item" onclick="toggleAccessibility('sign-language')">
                        <img id="sign-language" src="/media/sign-language.png" alt="Acessível em Libras">
                        <label>Acessível em Libras</label>
                    </div>
                    <div class="accessibility-item" onclick="toggleAccessibility('closed-caption')">
                        <img id="closed-caption" src="/media/closed-caption.png" alt="Legendas ocultas">
                        <label>Legendas ocultas</label>
                    </div>
                    <div class="accessibility-item" onclick="toggleAccessibility('dialogue-enhancement')">
                        <img id="dialogue-enhancement" src="/media/dialogue-enhancement.png" alt="Aprimoramento de Diálogo">
                        <label>Aprim. de Diálogo</label>
                    </div>
                    <div class="accessibility-item" onclick="toggleAccessibility('voice-guidance')">
                        <img id="voice-guidance" src="/media/voice-guidance.png" alt="Guia por Voz">
                        <label>Guia por Voz</label>
                    </div>
                </div>

                <div id="signing-config" class="signing-config" style="display: none;">
                    <h3>Configurações da Janela de Libras</h3>
                    <div class="signing-options">
                        <div>
                            <label for="closedSigningSide">Posição da Janela:</label>
                            <select id="closedSigningSide" name="closedSigningSide">
                                <option value="right">Direita</option>
                                <option value="left">Esquerda</option>
                            </select>
                        </div>
                        <div>
                            <label for="closedSigningWidth">Largura da Janela (%):</label>
                            <input type="range" min="14" max="28" value="28" id="closedSigningWidth" name="closedSigningWidth">
                            <span id="width-value">28%</span>
                        </div>
                    </div>
                </div>

                <div id="content-rating-section" class="content-rating-section" style="display: none;">
                    <h3>Classificação Máxima Permitida</h3>
                    <div class="ratings">
                        <img data-rating="L"  src="/media/rating/Livre.png"  alt="Livre"   onclick="selectMaxContentRating('L', this)">
                        <img data-rating="10" src="/media/rating/10anos.png" alt="10 anos" onclick="selectMaxContentRating('10', this)">
                        <img data-rating="12" src="/media/rating/12anos.png" alt="12 anos" onclick="selectMaxContentRating('12', this)">
                        <img data-rating="14" src="/media/rating/14anos.png" alt="14 anos" onclick="selectMaxContentRating('14', this)">
                        <img data-rating="16" src="/media/rating/16anos.png" alt="16 anos" onclick="selectMaxContentRating('16', this)">
                        <img data-rating="18" src="/media/rating/18anos.png" alt="18 anos" onclick="selectMaxContentRating('18', this)">
                    </div>
                    <input type="hidden" id="maxContentRating" name="maxContentRating" value="">
                </div>
            </form>
        </div>
        
        <div class="avatar-section">
            <button type="button" class="avatar-button" onclick="openAvatarSelection()">
                <div id="selected-avatar" class="avatar-preview"></div>
            </button>
            <label>Escolha seu Avatar:</label>
        </div>
    </div>

    <div id="avatar-modal" class="avatar-modal" style="display: none;">
        <div class="avatar-modal-content">
            <div class="modal-header">
                <h2>Escolha a cor do seu Avatar</h2>
                <button class="close-btn" onclick="closeAvatarModal()">&times;</button>
            </div>

            <div class="avatar-grid" id="avatar-grid">
                <!-- Avatars loaded dynamically -->
            </div>

            <div class="modal-actions">
                <button class="btn" onclick="closeAvatarModal()">Cancelar</button>
                <button class="btn advance" onclick="confirmAvatar()">Confirmar</button>
            </div>
        </div>
    </div>
    
    <div class="terms-actions">
        <div class="terms">
            <input type="checkbox" id="terms" name="terms" required>
            <label for="terms">
                Concordo com a coleta e processamento de meus dados para uma melhor experiência, em conformidade com a Lei Geral de Proteção de Dados Pessoais (LGPD).
                <a href="#">Saiba mais.</a>
            </label>
        </div>
        
        <div class="actions">
            <button type="button" id="btn-create" class="btn create" onclick="createAnother()">Criar Outro</button>
            <button type="button" id="btn-advance" class="btn advance" onclick="saveProfile()">Avançar</button>
        </div>
    </div>

    <script>
        function selectMaxContentRating(rating, element) {
            document.querySelectorAll('.ratings img').forEach(img => img.classList.remove('selected'));
            element.classList.add('selected');
            document.getElementById('maxContentRating').value = rating;
        }

        function toggleAccessibility(accessibilityId) {
            const element = document.getElementById(accessibilityId).parentElement;
            element.classList.toggle('selected');
            const isSelected = element.classList.contains('selected');

            if (accessibilityId === 'sign-language') {
                document.getElementById('signing-config').style.display = isSelected ? 'block' : 'none';
            }
            if (accessibilityId === 'closed-caption') {
                document.getElementById('closedCaptioningLanguage').style.display = isSelected ? 'block' : 'none';
            }
        }

        // Palette and default avatar: ../avatar.js.
        const AVATAR_COLORS = <%- JSON.stringify(avatarColors) %>;
        const DEFAULT_AVATAR_SVG = <%- JSON.stringify(defaultAvatar) %>;

        let selectedAvatar = DEFAULT_AVATAR_SVG;
        let tempSelectedAvatar = null;

        function renderSelectedAvatarPreview() {
            document.getElementById('selected-avatar').innerHTML = selectedAvatar;
        }

        function openAvatarSelection() {
            document.getElementById('avatar-modal').style.display = 'flex';
            tempSelectedAvatar = selectedAvatar;
            loadAvatarPalette();
        }

        function closeAvatarModal() {
            document.getElementById('avatar-modal').style.display = 'none';
            renderSelectedAvatarPreview();
            tempSelectedAvatar = null;
        }

        function loadAvatarPalette() {
            const grid = document.getElementById('avatar-grid');
            grid.innerHTML = '';

            AVATAR_COLORS.forEach(({ svg, name }) => {
                const div = document.createElement('div');
                div.className = 'avatar-option';
                div.dataset.svg = svg;
                if (svg === selectedAvatar || svg === tempSelectedAvatar) {
                    div.classList.add('selected');
                }
                div.onclick = () => selectAvatarFromModal(svg, div);
                div.innerHTML = svg + '<div class="avatar-name">' + name + '</div>';
                grid.appendChild(div);
            });
        }

        function selectAvatarFromModal(svg, element) {
            document.querySelectorAll('.avatar-option.selected').forEach(opt => opt.classList.remove('selected'));
            element.classList.add('selected');
            tempSelectedAvatar = svg;
            document.getElementById('selected-avatar').innerHTML = svg;
        }

        function confirmAvatar() {
            if (tempSelectedAvatar) {
                selectedAvatar = tempSelectedAvatar;
            }
            document.getElementById('avatar-modal').style.display = 'none';
            tempSelectedAvatar = null;
            renderSelectedAvatarPreview();
        }

        function saveProfile() {
            const name = document.getElementById('name').value.trim();
            const parentalControl = document.getElementById('parental-control').checked;

            const audioLanguage = document.getElementById('audioLanguage').value;
            const userInterfaceLanguage = document.getElementById('userInterfaceLanguage').value;

            const closedCaptioning   = document.getElementById('closed-caption').parentElement.classList.contains('selected');
            const closedSigning      = document.getElementById('sign-language').parentElement.classList.contains('selected');
            const audioDescription   = document.getElementById('audio-description').parentElement.classList.contains('selected');
            const dialogEnhancement  = document.getElementById('dialogue-enhancement').parentElement.classList.contains('selected');
            const voiceGuidance      = document.getElementById('voice-guidance').parentElement.classList.contains('selected');

            // closedCaptioningLanguage: applicable only if closedCaptioning =
            // true.
            const closedCaptioningLanguage = closedCaptioning
                ? document.getElementById('closedCaptioningLanguage').value
                : undefined;

            // Sign language window: applicable only if closedSigning = true.
            const closedSigningSide  = closedSigning ? document.getElementById('closedSigningSide').value  : undefined;
            const closedSigningWidth = closedSigning ? parseInt(document.getElementById('closedSigningWidth').value) : undefined;

            // maxContentRating: required only if parentalControl = true.
            const maxContentRating = parentalControl ? document.getElementById('maxContentRating').value : undefined;

            if (!name || !document.getElementById('terms').checked) {
                alert('Preencha o nome do perfil e aceite os termos.');
                return;
            }
            if (name.length > 20) {
                alert('O nome deve ter no maximo 20 caracteres.');
                return;
            }
            if (parentalControl && !maxContentRating) {
                alert('Selecione a classificacao maxima permitida.');
                return;
            }

            // Payload with the basic attributes of Table 7.
            const newProfile = {
                nickname: name,
                avatar: selectedAvatar,
                parentalControl,
                maxContentRating,
                audioLanguage,
                closedCaptioningLanguage,
                userInterfaceLanguage,
                closedCaptioning,
                closedSigning,
                closedSigningSide,
                closedSigningWidth,
                audioDescription,
                dialogEnhancement,
                voiceGuidance
            };

            // Profile creation belongs to the platform (POST on its own
            // origin).
            fetch('/profile/create', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(newProfile)
            })
            .then(async (response) => {
                const data = await response.json().catch(() => ({}));
                if (!response.ok) {
                    // 400 carries {error: message}; a platform failure carries
                    // {error: 200, description} (C.3.2 format).
                    const msg = typeof data.error === 'string' ? data.error : data.description;
                    throw new Error(msg || ('HTTP ' + response.status));
                }
                alert('Perfil criado com sucesso!');
                window.location.href = '/prfchs';
            })
            .catch(error => {
                console.error('Erro:', error);
                alert('Erro ao criar perfil: ' + error.message);
            });
        }

        function createAnother() {
            document.getElementById('profile-form').reset();
            document.querySelectorAll('.accessibility-item.selected').forEach(item => item.classList.remove('selected'));
            document.querySelectorAll('.ratings img.selected').forEach(img => img.classList.remove('selected'));
            document.getElementById('signing-config').style.display = 'none';
            document.getElementById('content-rating-section').style.display = 'none';
            document.getElementById('closedCaptioningLanguage').style.display = 'none';
            document.getElementById('width-value').textContent = '28%';
            document.getElementById('maxContentRating').value = '';
            selectedAvatar = DEFAULT_AVATAR_SVG;
            renderSelectedAvatarPreview();
            focusStop(0);
        }

        document.addEventListener('DOMContentLoaded', function() {
            document.getElementById('parental-control').addEventListener('change', function() {
                document.getElementById('content-rating-section').style.display = this.checked ? 'block' : 'none';
            });

            document.getElementById('closedSigningWidth').addEventListener('input', function() {
                document.getElementById('width-value').textContent = this.value + '%';
            });

            document.getElementById('audioLanguage').addEventListener('change', function() {
                const selectedLang = this.value;
                document.getElementById('closedCaptioningLanguage').value = selectedLang;
                document.getElementById('userInterfaceLanguage').value = selectedLang;
            });
        });

        let currentStopIdx = 0;

        function getFocusStops() {
            const isVisible = (el) => el && el.offsetParent !== null;
            const stops = [];
            const push = (el) => { if (isVisible(el)) stops.push(el); };

            push(document.getElementById('name'));
            push(document.getElementById('audioLanguage'));
            push(document.getElementById('userInterfaceLanguage'));
            push(document.getElementById('closedCaptioningLanguage'));
            push(document.getElementById('parental-control'));
            document.querySelectorAll('.ratings img').forEach(push);

            // accessibility-items in DOM order, with signing-config coming
            // right after "sign-language" when sign language is on.
            document.querySelectorAll('.accessibility-item').forEach(item => {
                push(item);
                const img = item.querySelector('img');
                if (img && img.id === 'sign-language' && item.classList.contains('selected')) {
                    push(document.getElementById('closedSigningSide'));
                    push(document.getElementById('closedSigningWidth'));
                }
            });

            push(document.querySelector('.avatar-button'));
            push(document.getElementById('terms'));
            push(document.getElementById('btn-create'));
            push(document.getElementById('btn-advance'));

            return stops;
        }

        function focusStop(idx) {
            const stops = getFocusStops();
            if (stops.length === 0) return;
            currentStopIdx = ((idx % stops.length) + stops.length) % stops.length;

            document.querySelectorAll('.kbd-focus').forEach(el => el.classList.remove('kbd-focus'));
            const el = stops[currentStopIdx];
            el.classList.add('kbd-focus');
            if (typeof el.focus === 'function') el.focus({ preventScroll: true });
            el.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }

        function activateStop() {
            const stops = getFocusStops();
            const el = stops[currentStopIdx];
            if (!el) return;

            if (el.tagName === 'INPUT' && el.type === 'checkbox') {
                el.checked = !el.checked;
                el.dispatchEvent(new Event('change', { bubbles: true }));
            } else if (typeof el.click === 'function') {
                el.click();
            }
        }

        document.addEventListener('keydown', function(e) {
            const modal = document.getElementById('avatar-modal');
            const isModalOpen = modal.style.display === 'flex';

            if (isModalOpen) {
                if (e.key === 'Escape') {
                    closeAvatarModal();
                } else if (e.key === 'Enter') {
                    confirmAvatar();
                } else if (e.key === 'ArrowLeft' || e.key === 'ArrowRight' || e.key === 'ArrowUp' || e.key === 'ArrowDown') {
                    const avatars = document.querySelectorAll('.avatar-option');
                    const selected = document.querySelector('.avatar-option.selected');
                    if (avatars.length > 0) {
                        let i = Array.from(avatars).indexOf(selected);
                        if (e.key === 'ArrowRight' || e.key === 'ArrowDown') i = (i + 1) % avatars.length;
                        else                                                  i = (i - 1 + avatars.length) % avatars.length;
                        avatars[i].click();
                        avatars[i].scrollIntoView({ behavior: 'smooth', block: 'center' });
                    }
                }
                e.preventDefault();
                return;
            }

            if (e.key === 'Escape') {
                window.location.href = '/prfchs';
                return;
            }

            const stops = getFocusStops();
            const el = stops[currentStopIdx];
            if (!el) return;

            if (el.tagName === 'INPUT' && el.type === 'text') {
                if (e.key === 'ArrowDown' || e.key === 'Enter') {
                    e.preventDefault();
                    focusStop(currentStopIdx + 1);
                } else if (e.key === 'ArrowUp') {
                    e.preventDefault();
                    focusStop(currentStopIdx - 1);
                }
                return;
            }

            if (el.tagName === 'SELECT') {
                if (e.key === 'ArrowLeft' || e.key === 'ArrowRight') {
                    e.preventDefault();
                    const dir = e.key === 'ArrowRight' ? 1 : -1;
                    el.selectedIndex = Math.max(0, Math.min(el.options.length - 1, el.selectedIndex + dir));
                    el.dispatchEvent(new Event('change', { bubbles: true }));
                } else if (e.key === 'ArrowDown') {
                    e.preventDefault();
                    focusStop(currentStopIdx + 1);
                } else if (e.key === 'ArrowUp') {
                    e.preventDefault();
                    focusStop(currentStopIdx - 1);
                } else if (e.key === 'Enter') {
                    e.preventDefault();
                    focusStop(currentStopIdx + 1);
                }
                return;
            }

            if (el.tagName === 'INPUT' && el.type === 'range') {
                if (e.key === 'ArrowDown') {
                    e.preventDefault();
                    focusStop(currentStopIdx + 1);
                } else if (e.key === 'ArrowUp') {
                    e.preventDefault();
                    focusStop(currentStopIdx - 1);
                } else if (e.key === 'Enter') {
                    e.preventDefault();
                    focusStop(currentStopIdx + 1);
                }
                // Left/Right keep the native behavior of the range.
                return;
            }

            if (e.key === 'ArrowDown' || e.key === 'ArrowRight') {
                e.preventDefault();
                focusStop(currentStopIdx + 1);
            } else if (e.key === 'ArrowUp' || e.key === 'ArrowLeft') {
                e.preventDefault();
                focusStop(currentStopIdx - 1);
            } else if (e.key === 'Enter' || e.key === ' ') {
                e.preventDefault();
                activateStop();
            }
        });

        window.addEventListener('load', () => {
            renderSelectedAvatarPreview();
            focusStop(0);
        });
    </script>
</body>
</html>
